@@ -0,0 +1,137 @@
+import type { ConnectivityMap } from "circuit-json-to-connectivity-map"
+import type { CapacityMeshNode } from "lib/types/capacity-mesh-types"
+import type { Obstacle, SimpleRouteJson } from "lib/types/srj-types"
+import { mapLayerNameToZ } from "lib/utils/mapLayerNameToZ"
+import { getPointToObstacleDistance } from "./Pipeline9RegionalFallbackSolver"
+
+type Bounds = { minX: number; maxX: number; minY: number; maxY: number }
+type AddViaSiteFractionsParams = {
+  nodes: CapacityMeshNode[]
+  srj: SimpleRouteJson
+  connMap: ConnectivityMap
+  viaDiameter: number
+  viaToPadClearance: number
+}
+type HardObstacle = { obstacle: Obstacle; bounds: Bounds; zLayers: number[] }
+
+/** Spacing of the sampled via centers, in mm. */
+const VIA_CENTER_SAMPLE_STEP = 0.025
+/** Most samples per axis, so a large node costs at most 30 × 30 checks. */
+const MAX_VIA_CENTER_SAMPLES_PER_AXIS = 30
+
+const getObstacleBounds = (obstacle: Obstacle): Bounds => {
+  const rotationRadians = ((obstacle.ccwRotationDegrees ?? 0) * Math.PI) / 180
+  const cos = Math.abs(Math.cos(rotationRadians))
+  const sin = Math.abs(Math.sin(rotationRadians))
+  const halfWidth = (obstacle.width / 2) * cos + (obstacle.height / 2) * sin
+  const halfHeight = (obstacle.width / 2) * sin + (obstacle.height / 2) * cos
+  return {
+    minX: obstacle.center.x - halfWidth,
+    maxX: obstacle.center.x + halfWidth,
+    minY: obstacle.center.y - halfHeight,
+    maxY: obstacle.center.y + halfHeight,
+  }
+}
+
+/**
+ * Record, on each free-space node that can hold a via, the share of its via
+ * centers that keep the via-to-pad clearance from copper its vias cannot touch.
+ * Path planning prices layer changes by node area; this lets it price them by
+ * the area where a via can actually go.
+ *
+ * Global free-space nodes may border copper directly, and the high-density
+ * solvers keep a via inside its node, so a node flush with pads or fixed traces
+ * can have far less room for a via than its size suggests, or none. Pads of
+ * nets this request routes are skipped: their own vias may sit beside them.
+ * Copper on layers the node does not offer, such as a plane, is left to the
+ * stages that already handle vias through it. Component topology nodes, which
+ * apply their own via rules, nodes too small for any via, and nodes with no
+ * copper in reach are returned unchanged. Board coordinates in mm, +X right,
+ * +Y up.
+ */
+export const addViaSiteFractions = ({
+  nodes,
+  srj,
+  connMap,
+  viaDiameter,
+  viaToPadClearance,
+}: AddViaSiteFractionsParams): CapacityMeshNode[] => {
+  const routedNetIds = new Set(
+    srj.connections.map(
+      (connection) =>
+        connMap.getNetConnectedToId(connection.name) ?? connection.name,
+    ),
+  )
+  const isRoutedNetObstacle = (obstacle: Obstacle): boolean =>
+    [obstacle.obstacleId, ...obstacle.connectedTo].some((id) => {
+      if (!id) return false
+      const netId = connMap.getNetConnectedToId(id)
+      return netId !== undefined && routedNetIds.has(netId)
+    })
+  const keepOut = viaDiameter / 2 + viaToPadClearance
+  const hardObstacles: HardObstacle[] = srj.obstacles
+    .filter((obstacle) => !isRoutedNetObstacle(obstacle))
+    .map((obstacle) => ({
+      obstacle,
+      bounds: getObstacleBounds(obstacle),
+      zLayers:
+        obstacle.zLayers ??
+        obstacle.layers.map((layer) => mapLayerNameToZ(layer, srj.layerCount)),
+    }))
+  return nodes.map((node): CapacityMeshNode => {
+    if (
+      node._isComponentTopologyNode ||
+      node._containsTarget ||
+      node._containsObstacle ||
+      node.availableZ.length < 2
+    )
+      return node
+    const centers: Bounds = {
+      minX: node.center.x - node.width / 2 + viaDiameter / 2,
+      maxX: node.center.x + node.width / 2 - viaDiameter / 2,
+      minY: node.center.y - node.height / 2 + viaDiameter / 2,
+      maxY: node.center.y + node.height / 2 - viaDiameter / 2,
+    }
+    if (centers.minX > centers.maxX || centers.minY > centers.maxY) return node
+    const nearby = hardObstacles.filter(
+      ({ bounds, zLayers }) =>
+        zLayers.some((z) => node.availableZ.includes(z)) &&
+        bounds.minX - keepOut < centers.maxX &&
+        bounds.maxX + keepOut > centers.minX &&
+        bounds.minY - keepOut < centers.maxY &&
+        bounds.maxY + keepOut > centers.minY,
+    )
+    if (nearby.length === 0) return node
+    const [xCount, yCount] = [
+      centers.maxX - centers.minX,
+      centers.maxY - centers.minY,
+    ].map((span) =>
+      Math.min(
+        MAX_VIA_CENTER_SAMPLES_PER_AXIS,
+        Math.max(2, Math.ceil(span / VIA_CENTER_SAMPLE_STEP) + 1),
+      ),
+    ) as [number, number]
+    let legalCount = 0
+    for (let xIndex = 0; xIndex < xCount; xIndex++) {
+      for (let yIndex = 0; yIndex < yCount; yIndex++) {
+        const point = {
+          x:
+            centers.minX +
+            ((centers.maxX - centers.minX) * xIndex) / (xCount - 1),
+          y:
+            centers.minY +
+            ((centers.maxY - centers.minY) * yIndex) / (yCount - 1),
+        }
+        if (
+          nearby.every(
+            ({ obstacle }) =>
+              getPointToObstacleDistance(point, obstacle) >= keepOut,
+          )
+        )
+          legalCount++
+      }
+    }
+    if (process.env.VIA_SITE_ZERO_ONLY === "1" && legalCount > 0) return node
+    return { ...node, _viaSiteFraction: legalCount / (xCount * yCount) }
+  })
+}
