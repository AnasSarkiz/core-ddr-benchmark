diff --git a/tests/region-via-area-fraction-cost.test.ts b/tests/region-via-area-fraction-cost.test.ts
new file mode 100644
index 0000000..b3b12c6
--- /dev/null
+++ b/tests/region-via-area-fraction-cost.test.ts
@@ -0,0 +1,15 @@
+import { expect, test } from "bun:test"
+import { computeRegionCost } from "lib/computeRegionCost"
+
+test("viaAreaFraction scales only the via term of the region cost", () => {
+  // A 1 x 1 region with two layers (mask 0b11), one entry/exit layer change,
+  // and four traces under the trace-density penalty.
+  const viaOnly = (viaAreaFraction: number) =>
+    computeRegionCost(1, 1, 0, 0, 1, 4, 0b11, 0.3, 0, viaAreaFraction)
+  const densityOnly = (viaAreaFraction: number) =>
+    computeRegionCost(1, 1, 0, 0, 0, 4, 0b11, 0.3, 1, viaAreaFraction)
+
+  expect(viaOnly(0.1)).toBeCloseTo(viaOnly(1) * 10, 12)
+  expect(densityOnly(0.1)).toBe(densityOnly(1))
+  expect(densityOnly(1)).toBeGreaterThan(0)
+})
diff --git a/tests/region-via-area-fraction-load.test.ts b/tests/region-via-area-fraction-load.test.ts
new file mode 100644
index 0000000..0f52f15
--- /dev/null
+++ b/tests/region-via-area-fraction-load.test.ts
@@ -0,0 +1,26 @@
+import { expect, test } from "bun:test"
+import { loadSerializedHyperGraph } from "lib/compat/loadSerializedHyperGraph"
+import { sameNetSharedBottleneckFixture } from "tests/fixtures/same-net-shared-bottleneck.fixture"
+
+test("serialized regions carry viaAreaFraction into the topology", () => {
+  const withFraction = (viaAreaFraction: unknown) => ({
+    ...sameNetSharedBottleneckFixture,
+    regions: sameNetSharedBottleneckFixture.regions.map((region, index) =>
+      index === 0 ? { ...region, d: { ...region.d, viaAreaFraction } } : region,
+    ),
+  })
+
+  const { topology } = loadSerializedHyperGraph(withFraction(0.1))
+  const regionIndex = topology.regionMetadata!.findIndex(
+    (metadata) => metadata?.viaAreaFraction === 0.1,
+  )
+  expect(regionIndex).toBeGreaterThanOrEqual(0)
+  expect(topology.regionViaAreaFraction![regionIndex]).toBe(0.1)
+  expect(
+    [...topology.regionViaAreaFraction!].filter((value) => value !== 1),
+  ).toEqual([0.1])
+
+  expect(() => loadSerializedHyperGraph(withFraction(0))).toThrow(
+    "expected a number in (0, 1]",
+  )
+})
