+    if (!currentContactKeys.has(contact.key)) return true
+  }
+  return false
+}
+
+/**
+ * A candidate is better when it has fewer DRC errors, or as many with a lower
+ * score. With rejectNewContacts, a candidate that puts two objects in contact
