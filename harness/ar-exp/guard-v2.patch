diff --git a/lib/autorouter-pipelines/AutoroutingPipeline9_PreloadedTraceGraph/addAutoroutingViaTraceIds.ts b/lib/autorouter-pipelines/AutoroutingPipeline9_PreloadedTraceGraph/addAutoroutingViaTraceIds.ts
