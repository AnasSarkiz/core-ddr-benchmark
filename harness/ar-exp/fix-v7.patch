+  // A trace touching another trace or its via names two different traces.
+  const traceIds: unknown[] = Array.isArray(error.pcb_trace_ids)
+    ? error.pcb_trace_ids
+    : []
+  const isTracePair =
+    traceIds.length === 2 &&
+    traceIds.every((id) => typeof id === "string" && id !== "") &&
