+/** Identifies a short by what touches, whichever side reported it. */
+export const getPipeline9DrcContactKey = (
+  contact: AutoroutingDrcContact,
+): string => {
+  if ("obstacle_id" in contact) {
+    return `trace ${contact.pcb_trace_id} touches obstacle ${contact.obstacle_id}`
+  }
+  // Touching another trace's wire or its via shorts the same two traces.
+  const otherTraceId =
+    "via_pcb_trace_id" in contact
+      ? contact.via_pcb_trace_id
+      : contact.other_pcb_trace_id
+  const [firstTraceId, secondTraceId] = [
+    contact.pcb_trace_id,
+    otherTraceId,
+  ].sort()
+  return `trace ${firstTraceId} touches trace ${secondTraceId}`
+}
