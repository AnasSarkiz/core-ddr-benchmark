diff --git a/lib/later-bus-carriers.ts b/lib/later-bus-carriers.ts
new file mode 100644
index 0000000..3cf8eca
--- /dev/null
+++ b/lib/later-bus-carriers.ts
@@ -0,0 +1,66 @@
+import { getCopperLayerNames } from "@tscircuit/fanout-solver"
+import { expandedSignalSiteChoices } from "./expanded-signal-sites"
+import type { Connection, PendingRoutingAccess, SimpleRouteJson } from "./types"
+
+type ConnectionName = string
+type LayerName = string
+
+/** Whether a signal has a carrier on one of `layers` beside the copper in
+ * `input`: the solver's expanded via sites at both pads, joined by a legal
+ * path on that layer. */
+function* hasCarrier(
+  input: SimpleRouteJson,
+  connection: Connection,
+  layers: LayerName[],
+): Generator<void, boolean> {
+  for (const layer of layers) {
+    const choices = expandedSignalSiteChoices({
+      input,
+      connection,
+      targetLayer: layer,
+      limit: 1,
+    })
+    let step = choices.next()
+    while (!step.done) {
+      yield
+      step = choices.next()
+    }
+    if (step.value.length) return true
+  }
+  return false
+}
+
+/** Two-pad signals of a later bus that have a carrier off their pads' layer
+ * beside the copper in `before` and none beside the copper in `after`. Such a
+ * signal can then only route on its pads' layer, where it has to pass every
+ * other pad and route in between. Losing one of several carrier layers does
+ * not count. Board coordinates in mm, +X right, +Y up. */
+export function* getStrandedLaterSignals({
+  before,
+  after,
+  laterBus,
+}: {
+  before: SimpleRouteJson
+  after: SimpleRouteJson
+  laterBus: PendingRoutingAccess
+}): Generator<void, ConnectionName[]> {
+  const stranded: ConnectionName[] = []
+  for (const connection of laterBus.connections) {
+    const bus = laterBus.buses?.find((candidate) =>
+      candidate.connectionNames.includes(connection.name),
+    )
+    const padLayers = new Set(
+      connection.pointsToConnect.map((point) => point.layer),
+    )
+    if (!bus || connection.pointsToConnect.length !== 2 || padLayers.size > 1)
+      continue
+    const layers = (
+      bus.allowedLayers ?? getCopperLayerNames(before.layerCount)
+    ).filter((layer) => !padLayers.has(layer))
+    if (!layers.length || (yield* hasCarrier(after, connection, layers)))
+      continue
+    if (yield* hasCarrier(before, connection, layers))
+      stranded.push(connection.name)
+  }
+  return stranded
+}
diff --git a/lib/plan-with-pending-buses.ts b/lib/plan-with-pending-buses.ts
new file mode 100644
index 0000000..e340e22
--- /dev/null
+++ b/lib/plan-with-pending-buses.ts
@@ -0,0 +1,58 @@
+import type { PendingRoutingAccess, SimpleRouteJson } from "./types"
+
+type PhysicalRuleName = Exclude<
+  keyof PendingRoutingAccess,
+  "connections" | "buses"
+>
+
+const PHYSICAL_RULE_NAMES: PhysicalRuleName[] = [
+  "minTraceWidth",
+  "minTraceToPadEdgeClearance",
+  "minViaPadDiameter",
+  "minViaHoleDiameter",
+  "minViaHoleEdgeToViaHoleEdgeClearance",
+  "minBoardEdgeClearance",
+  "allowViaInPad",
+  "allowBlindAndBuriedVias",
+]
+
+export interface NextBusPlan {
+  /** The current request without later-phase intent. */
+  alone: SimpleRouteJson
+  /** The next later phase that routes buses. */
+  laterBus: PendingRoutingAccess
+  /** The current request routed together with that later bus. */
+  joint: SimpleRouteJson
+}
+
+/** Requests for planning the current buses beside the next later bus. Laying
+ * out one bus without the next can leave the next one no legal carrier: an
+ * earlier byte's carriers may enclose every via site of a later byte. Only a
+ * later phase with the current request's physical rules, as this solver reads
+ * them, can share one request. Returns undefined when the next later phase
+ * routes no buses or uses other rules. Board coordinates in mm, +X right, +Y up. */
+export function getNextBusPlan(
+  input: SimpleRouteJson,
+): NextBusPlan | undefined {
+  if (!input.buses?.length) return undefined
+  const laterBus = input.pendingRoutingAccess?.find(
+    (access) => access.buses?.length,
+  )
+  if (
+    !laterBus ||
+    PHYSICAL_RULE_NAMES.some(
+      (rule) => laterBus[rule] !== undefined && laterBus[rule] !== input[rule],
+    )
+  )
+    return undefined
+  const { pendingRoutingAccess: _pending, ...alone } = input
+  return {
+    alone,
+    laterBus,
+    joint: {
+      ...alone,
+      connections: [...input.connections, ...laterBus.connections],
+      buses: [...input.buses, ...laterBus.buses!],
+    },
+  }
+}
